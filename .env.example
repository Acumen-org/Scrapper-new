# Bellwether configuration. Copy to .env and fill in.
#
# .env is gitignored. Nothing secret belongs in a tracked file, and nothing here
# affects how any score is computed, so changing these never invalidates
# recorded config stamps.

# Signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leave unset and a key is generated once into data/secret_key instead. Changing
# it signs everyone out, which is the correct behaviour, not a bug.
BELLWETHER_SECRET=

# Real contact address for the User-Agent. The SEC requires one and blocks
# traffic without it. Use a monitored mailbox.
BELLWETHER_CONTACT=contact@acumen-strategy.com

# Set to 1 when served over HTTPS so session cookies are marked Secure.
# Leave unset for plain http on your own machine.
BELLWETHER_HTTPS=1

# Where the database and captured data live. Unset means alongside the code,
# which is what you want locally. A container points both at its volume.
# BELLWETHER_DB=/data/prospect.db
# BELLWETHER_DATA=/data

# Where accounts live. Unset means config/users.yml, which is right locally and
# wrong in a container: the image is rebuilt on every deploy and the accounts in
# it go with it. The Dockerfile already points this at the volume, so you only
# ever set this by hand if you are running outside a container and want the
# accounts file somewhere else.
# BELLWETHER_USERS=/data/users.yml

# Set by the Dockerfile, not normally by you. Tells the app that something else
# starts and stops it, so the sidebar stops offering a Quit button that would
# take the server down under everyone else using it.
# BELLWETHER_MANAGED=1

# Where Postgres is. Required.
# BELLWETHER_DSN=postgresql://bellwether:PASSWORD@db:5432/bellwether

# Optional. Each of these can also be set by an admin in Settings, which is the
# usual way; setting it here pins it and the screen shows it as fixed.
# BELLWETHER_PUBLIC_URL=https://bellwether.acumen-strategy.com
# BELLWETHER_ADMINS=rahul.gopan@acumen-strategy.com
# BELLWETHER_MS_TENANT=
# BELLWETHER_MS_CLIENT_ID=
# BELLWETHER_MS_CLIENT_SECRET=
# BELLWETHER_AI_KEY=
# BELLWETHER_REACHER_URL=http://reacher:8080

# Set to 0 on a test copy so it does not crawl websites or check mail servers
# on its own.
# BELLWETHER_SCHEDULER=1
