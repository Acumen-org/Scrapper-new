    },
    {
      "name": "Research Disclosure",
      "kind": "card",
      "refersTo": "research-panel",
      "description": "Secondary evidence stays accessible in a named disclosure.",
      "html": "<details class=\"ds-research\"><summary class=\"ds-research-summary\">Contacts and sources</summary><p class=\"ds-research-copy\">Contact evidence and verification details appear here when available.</p></details>",
      "css": ".ds-research{font-family:var(--sans,\"Instrument Sans\",\"Segoe UI\",sans-serif);border:1px solid var(--rule,#333333);background:var(--raise,#1d1d1d);color:var(--ink,#f0f0f0);border-radius:12px;padding:20px;}.ds-research-summary{font-size:15px;font-weight:550;cursor:pointer;list-style:none;}.ds-research-summary::-webkit-details-marker{display:none;}.ds-research[open]>.ds-research-summary{margin-bottom:24px;}.ds-research-copy{color:var(--soft,#bdbdbd);font-size:13px;line-height:1.55;}.ds-research-summary:focus-visible{outline:2px solid var(--red-hi,#ef939c);outline-offset:3px;}"
    },
    {
      "name": "Fit and Coverage",
      "kind": "custom",
      "refersTo": "research-panel",
      "description": "A neutral score summary preserves visible unknown coverage.",
      "html": "<a class=\"ds-fit\" href=\"#fit\"><span class=\"ds-fit-label\">Product fit</span><strong class=\"ds-fit-score\">Unknown</strong><span class=\"ds-coverage\" role=\"img\" aria-label=\"No known coverage\"></span><span class=\"ds-fit-meta\">Evidence not recorded</span></a>",
      "css": ".ds-fit{font-family:var(--sans,\"Instrument Sans\",\"Segoe UI\",sans-serif);display:flex;flex-direction:column;gap:9px;padding:18px;border:1px solid var(--rule,#333333);border-radius:10px;color:var(--ink,#f0f0f0);background:transparent;text-decoration:none;}.ds-fit:hover{border-color:var(--rule2,#4a4a4a);background:var(--raise2,#272727);}.ds-fit-label{font-size:12px;}.ds-fit-score{font-size:30px;font-weight:550;line-height:1.2;font-variant-numeric:tabular-nums;}.ds-coverage{height:4px;border-radius:2px;background:var(--hatch,repeating-linear-gradient(135deg,rgba(207,169,92,.55) 0 3px,rgba(207,169,92,.12) 3px 6px));overflow:hidden;}.ds-fit-meta{font-size:11px;color:var(--amber,#cfa95c);}.ds-fit:focus-visible{outline:2px solid var(--red-hi,#ef939c);outline-offset:3px;}"
    },
