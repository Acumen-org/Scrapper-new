      "css": ".ds-field{font-family:var(--sans,\"Instrument Sans\",\"Segoe UI\",sans-serif);display:flex;flex-direction:column;gap:6px;color:var(--soft,#bdbdbd);font-size:12px;}.ds-search{font-family:var(--sans,\"Instrument Sans\",\"Segoe UI\",sans-serif);min-height:40px;padding:7px 10px;border:1px solid var(--rule2,#4a4a4a);border-radius:8px;background:var(--bg,#151515);color:var(--ink,#f0f0f0);font-size:14px;caret-color:var(--red-hi,#ef939c);}.ds-search::placeholder{color:var(--faint,#a0a0a0);opacity:1;}.ds-search:focus,.ds-search:focus-visible{outline:none;border-color:var(--red,#b73545);box-shadow:0 0 0 2px var(--red-bg,rgba(181,46,59,.15));}"
    },
    {
      "name": "Workflow Navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "Equal workflow links with quiet active emphasis.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><a class=\"ds-nav-link\" href=\"#firms\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M3 21h18M6 21V7l6-4 6 4v14M9 10h1m4 0h1m-6 4h1m4 0h1m-4 7v-4h2v4\"/></svg>Firms</a><a class=\"ds-nav-link\" href=\"#people\">People</a><a class=\"ds-nav-link\" href=\"#signals\">Signals</a></nav>",
      "css": ".ds-nav{font-family:var(--sans,\"Instrument Sans\",\"Segoe UI\",sans-serif);display:flex;flex-direction:column;gap:5px;background:var(--side,#111111);padding:14px;}.ds-nav-link{display:flex;align-items:center;gap:10px;padding:11px 12px;border-radius:7px;color:var(--soft,#bdbdbd);font-size:14px;text-decoration:none;transition:background .12s,color .12s;}.ds-nav-link:hover{background:rgba(255,255,255,.04);color:var(--ink,#f0f0f0);}.ds-nav-link[aria-current=page]{background:#292020;color:var(--ink,#f0f0f0);font-weight:600;}.ds-nav-link svg{width:17px;height:17px;color:var(--red-hi,#ef939c);}.ds-nav-link:focus-visible{outline:2px solid var(--red-hi,#ef939c);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-nav-link{transition:none;}}"
    },
    {
      "name": "Verified Status",
      "kind": "chip",
