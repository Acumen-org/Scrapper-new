      "description": "A labeled solid field with visible functional focus.",
      "html": "<label class=\"ds-field\">Owner<input class=\"ds-input\" type=\"text\" placeholder=\"Name\"></label>",
      "css": ".ds-field{font-family:var(--sans,\"Instrument Sans\",\"Segoe UI\",sans-serif);display:flex;flex-direction:column;gap:6px;color:var(--faint,#a0a0a0);font-size:12px;font-weight:500;}.ds-input{font-family:var(--sans,\"Instrument Sans\",\"Segoe UI\",sans-serif);height:36px;padding:0 11px;border:1px solid var(--rule2,rgba(255,255,255,.13));border-radius:8px;background:var(--raise,#222222);color:var(--ink,#f0f0f0);font-size:13.5px;caret-color:var(--red-hi,#ef939c);transition:border-color .12s,box-shadow .12s;}.ds-input::placeholder{color:var(--dim,#999999);opacity:1;}.ds-input:hover{border-color:var(--line3,rgba(255,255,255,.2));}.ds-input:focus,.ds-input:focus-visible{outline:none;border-color:var(--red-hi,#ef939c);box-shadow:0 0 0 3px var(--red-bg,rgba(230,72,80,.13));}@media(prefers-reduced-motion:reduce){.ds-input{transition:none;}}"
    },
    {
      "name": "Workflow Navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "Equal workflow links with a neutral selected surface and red marker.",
      "html": "<nav class=\"ds-navigation\" aria-label=\"Explore\"><a class=\"ds-nav-link\" href=\"#firms\" aria-current=\"page\">Firms</a><a class=\"ds-nav-link\" href=\"#people\">People</a><a class=\"ds-nav-link\" href=\"#signals\">Signals</a></nav>",
      "css": ".ds-navigation{font-family:var(--sans,\"Instrument Sans\",\"Segoe UI\",sans-serif);display:flex;flex-direction:column;background:var(--side,#111111);padding:12px;}.ds-nav-link{display:flex;align-items:center;position:relative;height:34px;padding:0 10px;border-radius:8px;color:var(--soft,#bdbdbd);font-size:13.5px;font-weight:500;text-decoration:none;transition:background .12s,color .12s;}.ds-nav-link:hover{background:rgba(255,255,255,.045);color:var(--ink,#f0f0f0);}.ds-nav-link[aria-current=page]{background:rgba(255,255,255,.075);color:var(--ink,#f0f0f0);}.ds-nav-link[aria-current=page]::before{content:\"\";position:absolute;left:-12px;top:9px;bottom:9px;width:3px;border-radius:0 3px 3px 0;background:var(--red,#b73545);}.ds-nav-link:focus-visible{outline:2px solid var(--red-hi,#ef939c);outline-offset:2px;}@media(prefers-reduced-motion:reduce){.ds-nav-link{transition:none;}}"
    },
    {
      "name": "Contact Status",
      "kind": "chip",
      "refersTo": "chip-verified",
      "description": "Verified and published remain visibly distinct evidence states.",
      "html": "<div class=\"ds-statuses\"><span class=\"ds-chip ds-verified\">Verified</span><span class=\"ds-chip ds-published\">Published</span></div>",
      "css": ".ds-statuses{display:flex;gap:8px;}.ds-chip{font-family:var(--sans,\"Instrument Sans\",\"Segoe UI\",sans-serif);display:inline-flex;align-items:center;height:22px;padding:0 8px;border-radius:6px;font-size:11.5px;font-weight:500;line-height:1;white-space:nowrap;border:1px solid transparent;}.ds-verified{background:var(--ok-bg,rgba(69,192,138,.12));color:var(--ok,#45c08a);border-color:var(--ok-line,rgba(69,192,138,.32));}.ds-published{background:transparent;color:var(--faint,#a0a0a0);border-color:var(--rule2,rgba(255,255,255,.13));}"
    },
    {
      "name": "Contained Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Solid containment for detailed sections; summaries can remain open rows.",
      "html": "<section class=\"ds-panel\"><h2>Technology</h2><p>No recorded technology.</p></section>",
      "css": ".ds-panel{font-family:var(--sans,\"Instrument Sans\",\"Segoe UI\",sans-serif);padding:20px;border:1px solid var(--line,rgba(255,255,255,.07));border-radius:12px;background:var(--card,#1c1c1c);color:var(--ink,#f0f0f0);}.ds-panel h2{margin:0 0 14px;font-size:17px;font-weight:600;line-height:1.35;letter-spacing:-.015em;}.ds-panel p{font-size:14px;line-height:1.55;color:var(--faint,#a0a0a0);}"
    },
    {
      "name": "Workspace Tabs",
      "kind": "nav",
      "refersTo": "workspace-tab",
      "description": "Plain horizontally scrolling labels with a red selection underline.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Dashboard views\"><button class=\"ds-tab\" type=\"button\" role=\"tab\" aria-selected=\"true\">Overview</button><button class=\"ds-tab\" type=\"button\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Product lists</button><button class=\"ds-tab\" type=\"button\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Your workspace</button></div>",
      "css": ".ds-tabs{font-family:var(--sans,\"Instrument Sans\",\"Segoe UI\",sans-serif);display:flex;gap:26px;border-bottom:1px solid var(--line,rgba(255,255,255,.07));overflow-x:auto;}.ds-tab{font-family:var(--sans,\"Instrument Sans\",\"Segoe UI\",sans-serif);height:46px;padding:0 0 14px;border:0;border-bottom:2px solid transparent;border-radius:0;background:none;color:var(--faint,#a0a0a0);font-size:13px;font-weight:500;white-space:nowrap;cursor:pointer;}.ds-tab:hover{color:var(--ink,#f0f0f0);}.ds-tab[aria-selected=true]{color:var(--ink,#f0f0f0);border-bottom-color:var(--red,#b73545);}.ds-tab:focus-visible{outline:2px solid var(--red-hi,#ef939c);outline-offset:2px;}"
    },
    {
      "name": "Fit Summary",
      "kind": "custom",
      "refersTo": "fit-summary",
      "description": "An open firm-overview row pairs a score with explicit known-data coverage; Home retains this evidence pairing within its leading-firms table.",
      "html": "<a class=\"ds-fit\" href=\"#fit\"><span>AcuBooth<small>82% known data</small></span><strong>70<small>/100</small></strong></a>",
      "css": ".ds-fit{font-family:var(--sans,\"Instrument Sans\",\"Segoe UI\",sans-serif);display:flex;justify-content:space-between;align-items:center;gap:24px;padding:15px 0;border-bottom:1px solid var(--rule,rgba(255,255,255,.07));color:var(--ink,#f0f0f0);font-size:14px;text-decoration:none;}.ds-fit>span>small{display:block;margin-top:4px;color:var(--amber,#e8ac4a);font-size:12px;}.ds-fit strong{font-size:24px;font-weight:550;font-variant-numeric:tabular-nums;}.ds-fit strong small{margin-left:3px;color:var(--faint,#a0a0a0);font-size:12px;font-weight:400;}.ds-fit:hover{color:var(--red-hi,#ef939c);}.ds-fit:focus-visible{outline:2px solid var(--red-hi,#ef939c);outline-offset:2px;}"
    },
    {
      "name": "Microsoft Sign-in",
      "kind": "button",
      "refersTo": "microsoft-sign-in",
      "description": "The full-width, 48px light action with its icon and label centered together, inside the form area of the segmented 460px sign-in panel.",
      "html": "<button class=\"ds-microsoft\" type=\"button\"><svg aria-hidden=\"true\" viewBox=\"0 0 21 21\"><path fill=\"#f25022\" d=\"M0 0h10v10H0z\"/><path fill=\"#7fba00\" d=\"M11 0h10v10H11z\"/><path fill=\"#00a4ef\" d=\"M0 11h10v10H0z\"/><path fill=\"#ffb900\" d=\"M11 11h10v10H11z\"/></svg>Sign in with Microsoft</button>",
      "css": ".ds-microsoft{font-family:var(--sans,\"Instrument Sans\",\"Segoe UI\",sans-serif);height:36px;padding:0 14px;border:1px solid var(--rule2,rgba(255,255,255,.13));border-radius:8px;font-size:13px;font-weight:500;line-height:1;display:inline-flex;align-items:center;justify-content:center;gap:7px;cursor:pointer;transition:background .12s,border-color .12s,color .12s,transform .06s;width:100%;height:48px;gap:12px;font-size:14px;font-weight:600;border:0;background:#f4f4f5;color:#151515;}.ds-microsoft svg{width:18px;height:18px;}.ds-microsoft:hover{background:#fff;color:#000;}.ds-microsoft:active{transform:translateY(1px);}.ds-microsoft:focus-visible{outline:2px solid var(--red-hi,#ef939c);outline-offset:2px;}@media(prefers-reduced-motion:reduce){.ds-microsoft{transition:none;}}"
    }
  ],
  "narrative": {
    "northStar": "The Intelligence Workspace",
    "overview": "Bellwether is a serious, neutral charcoal workspace in which firm identity, evidence and available actions are easy to scan. Restrained red supplies emphasis; hierarchy comes from type, space, fine rules and named views. Summary rows keep the first view quiet while complete research and operational detail remain reachable.\n\nThe October 2026 refinement keeps self-hosted Instrument Sans, solid surfaces and a professional sign-in experience. The shipped identity is the red rounded-square mark with three stacked white chevrons in `prospect/static/mark.svg`. Reuse that asset rather than rebuilding it.",
    "keyCharacteristics": [
      "Solid charcoal surfaces with restrained red emphasis.",
      "Plain summary rows and generous separation between evidence groups.",
      "Named, directly addressable views for every major workflow.",
      "Explicit contact provenance and score uncertainty.",
      "Compact controls, visible keyboard focus and responsive layouts."
    ],
    "rules": [
      {
        "name": "The Signal Rule",
        "body": "Use red for actions, selection or meaningful status; keep large backgrounds neutral.",
        "section": "colors"
      },
      {
        "name": "The Evidence Rule",
        "body": "Pair semantic color with explicit labels and values. Distinguish verified from published contacts, and missing evidence from known facts.",
        "section": "colors"
      },
      {
        "name": "The One Voice Rule",
        "body": "Keep Instrument Sans across headings, body and controls; express hierarchy with size, weight and spacing.",
        "section": "typography"
      },
      {
        "name": "The Named Views Rule",
        "body": "Reduce simultaneous detail through clearly named views without removing supported workflows or their data.",
        "section": "layout"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Separate ordinary content through tone, space and rules; reserve strong elevation for temporary overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep major surfaces solid charcoal and use red for purposeful emphasis.",
      "**Do** retain the shipped mark asset and self-hosted Instrument Sans.",
      "**Do** keep every GTM workflow accessible through visible navigation or a named view.",
      "**Do** label verified and published email distinctly and keep missing score evidence explicit.",
      "**Do** use concise headings and show supporting explanation where it helps a decision.",
      "**Do** preserve keyboard focus, hash navigation, responsive reflow and reduced-motion support."
    ],
    "donts": [
      "**Don't** add glass, backdrop blur, decorative glow, blue-tinted surfaces or theatrical login graphics.",
      "**Don't** turn every fact into a card or add introductory copy that repeats a heading.",
      "**Don't** introduce decorative eyebrows, glyph-based icon substitutes or a separate display font.",
      "**Don't** hide uncertainty behind a score or style published email as verified.",
      "**Don't** treat unused stylesheets, old screenshots or residual legacy declarations as the system for new work."
    ]
  }
}
